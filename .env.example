# Voice Khata — Server Configuration Template
# Copy this file to .env.local (git-ignored) and fill in your credentials.
# Never commit real API keys, secret keys, or database passwords into .env.example.

PORT=3000
HOST=0.0.0.0

# Gnani Voice API Credentials (kept strictly server-side, never exposed to browser)
GNANI_API_KEY=
GNANI_ACCESS_KEY=
GNANI_PRISMA_WS_URL=wss://asr.gnani.ai/v1/stream
GNANI_PRISMA_HTTP_URL=
GNANI_TIMBRE_TTS_URL=https://tts.gnani.ai/v1/synthesize
GNANI_TTS_VOICE=en-IN-female-1
GNANI_STT_LANG=en-IN

# Supabase Auth & @supabase/server Config
# Publishable key is safe for browser auth; SUPABASE_SECRET_KEY & DB URLs stay strictly server-side.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Prisma + Supabase PostgreSQL Pooler Connection Strings
# Transaction-mode pooler (IPv4-only, port 6543 with pgbouncer=true)
DATABASE_URL=
# Session-mode pooler (port 5432, used for Prisma migrations)
DIRECT_URL=
# Direct Postgres URI for @supabase/server
SUPABASE_DB_URL=
